# Supabase — necessário para o cliente em src/lib/supabase.js
# VITE_SUPABASE_PUBLISHABLE_KEY é a chave "publishable" do novo sistema
# de API keys do Supabase — não a chave anon legacy. Sem fallback: se
# ausente, o app falha fechado (ver src/lib/supabase.js).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# =========================================================
# Asaas — NÃO são variáveis do frontend (não usar prefixo VITE_,
# senão ficam públicas no bundle). Configurar como Secrets das
# Edge Functions create-asaas-checkout e asaas-webhook, no painel
# do Supabase (Project Settings → Edge Functions → Secrets) ou via
# `supabase secrets set` se você usar a CLI.
# =========================================================
#
# ASAAS_API_KEY=
#
# Sandbox:
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Produção:
# ASAAS_BASE_URL=https://api.asaas.com/v3
#
# Token opcional configurado também no painel da Asaas, usado pelo
# asaas-webhook para validar que a chamada realmente veio da Asaas.
# ASAAS_WEBHOOK_TOKEN=
#
# URL canônica do site, usada pela create-asaas-checkout para montar
# as URLs de retorno (successUrl/cancelUrl/expiredUrl).
# SITE_URL=https://nortisconcursos.com.br
